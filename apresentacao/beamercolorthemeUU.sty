\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamercolorthemeUU}[2026/05/14 v1.1.0-ITA ITA Beamer Color Theme]
\RequirePackage{xcolor}

% --- ITA palette (mantém os nomes UU para compatibilidade com o tema) ---
\definecolor{UUyellow}{HTML}{FFCD00}       % acento dourado (barra lateral, bullets)
\definecolor{UUred}{HTML}{C00A35}          % alertas
\definecolor{UUblack}{HTML}{000000}
\definecolor{UUwhite}{HTML}{FFFFFF}
\definecolor{UUcream}{HTML}{FFE6AB}
\definecolor{UUorange}{HTML}{F3965E}
\definecolor{UUburgundy}{HTML}{AA1555}
\definecolor{UUbrown}{HTML}{6E3B23}
\definecolor{UUgreen}{HTML}{24A793}
\definecolor{UUblue}{HTML}{0066CC}         % azul ITA médio
\definecolor{UUdarkblue}{HTML}{003782}     % azul ITA primário
\definecolor{UUpurple}{HTML}{5B2182}
\definecolor{UUlightgray}{HTML}{F5F5F3}
\definecolor{UUmidgray}{HTML}{D9D9D9}
\definecolor{UUdarkgray}{HTML}{5A5A5A}

% Cores adicionais para uso nos slides
\definecolor{positivegreen}{HTML}{1A7F37}
\definecolor{negativered}{HTML}{C00A35}

\setbeamercolor{structure}{fg=UUdarkblue}
\setbeamercolor{title}{fg=UUblack}
\setbeamercolor{subtitle}{fg=UUdarkgray}
\setbeamercolor{author}{fg=UUdarkblue}
\setbeamercolor{institute}{fg=UUdarkgray}
\setbeamercolor{date}{fg=UUdarkgray}
\setbeamercolor{frametitle}{fg=UUblack,bg=UUwhite}
\setbeamercolor{framesubtitle}{fg=UUdarkgray}
\setbeamercolor{normal text}{fg=UUblack,bg=UUwhite}
\setbeamercolor{alerted text}{fg=UUred}
\setbeamercolor{example text}{fg=UUgreen}
\setbeamercolor{block title}{fg=UUwhite,bg=UUdarkblue}
\setbeamercolor{block body}{fg=UUblack,bg=UUlightgray}
\setbeamercolor{block title alerted}{fg=UUwhite,bg=UUred}
\setbeamercolor{block body alerted}{fg=UUblack,bg=UUlightgray}
\setbeamercolor{block title example}{fg=UUwhite,bg=UUgreen}
\setbeamercolor{block body example}{fg=UUblack,bg=UUlightgray}
\setbeamercolor{item}{fg=UUyellow}
\setbeamercolor{subitem}{fg=UUorange}
\setbeamercolor{subsubitem}{fg=UUbrown}
\setbeamercolor{item projected}{fg=UUblack,bg=UUyellow}
\setbeamercolor{footline}{fg=UUdarkgray,bg=UUwhite}
